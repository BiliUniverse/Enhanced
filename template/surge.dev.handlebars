[Map Local]
^https:\/\/biliverse\.github\.io\/settings\/(?:[a-zA-Z0-9_-]+\/?)?(?:\?.*)?$ data-type=file data="https://biliverse.github.io/settings/assets/index.html" status-code=200 header="Content-Type:text/html; charset=utf-8|Cache-Control:no-store"
^https:\/\/biliverse\.github\.io\/configs\/Enhanced(?:\?.*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Enhanced.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store"

[Script]
📺 BiliBili.Enhanced.Settings = type=http-request, pattern=^https:\/\/biliverse\.github\.io\/api\/Enhanced(?:\/|\?|$), requires-body=1, max-size=65536, script-path=https://biliverse.github.io/settings/assets/Enhanced.request.js
📺 BiliBili.Enhanced.x.resource.show.tab.v2 = type=http-request, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?, script-path=https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/request.dev.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.account.mine = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?, requires-body=1, script-path=https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.region.index = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?, requires-body=1, script-path=https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js, argument={{{scriptParams}}}
📺 BiliBili.Enhanced.x.v2.channel.region.list = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?, requires-body=1, script-path=https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js, argument={{{scriptParams}}}

[MITM]
hostname = %APPEND% biliverse.github.io, app.bilibili.com, app.biliapi.net
