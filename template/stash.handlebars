name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{@package 'version'}}"

http:
  mitm:
    - "biliverse.github.io"
    - "app.bilibili.com"
    - "app.biliapi.net"
  script:
    - match: ^https:\/\/biliverse\.github\.io\/(?:api\/(?:get|set|delete)|settings\/(?:[a-zA-Z0-9_-]+\/?|assets\/app\.mjs))(?:\?.*)?$
      name: PreferencePanes.API
      type: request
      require-body: true
      max-size: 65536
    - match: ^https:\/\/biliverse\.github\.io\/configs\/Enhanced(?:\?.*)?$
      name: 📺 BiliBili.Enhanced.Config
      type: request
      require-body: false
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?
      name: 📺 BiliBili.Enhanced.request
      type: request
      require-body: false
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?
      name: 📺 BiliBili.Enhanced.response
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?
      name: 📺 BiliBili.Enhanced.response
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?
      name: 📺 BiliBili.Enhanced.response
      type: response
      require-body: true

script-providers:
  PreferencePanes.API:
    url: https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
    interval: 86400
  📺 BiliBili.Enhanced.Config:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/config.bundle.js
    interval: 86400
  📺 BiliBili.Enhanced.request:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/request.bundle.js
    interval: 86400
  📺 BiliBili.Enhanced.response:
    url: https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js
    interval: 86400
